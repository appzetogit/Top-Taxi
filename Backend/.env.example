# Server Configuration
PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?appName=k9

MONGODB_DB_NAME=K9

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_ACCESS_EXPIRES=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES=30d


# Frontend URL (for CORS)
FRONTEND_URL=https://gogo.org.in,https://gogo.org.in

# Absolute origin that uploaded-image URLs are prefixed with. Required in
# production: without it, uploaded URLs are relative ("/uploads/..."), which
# the Flutter app can't resolve and which the Master > Brand & Contact "Logo"
# save rejects outright with "Upload an image or paste an https:// link".
UPLOAD_BASE_URL=https://gogo.org.in/uploads


# Realtime & Queue Configuration
# Redis Configuration - Set REDIS_ENABLED=true to use Redis caching
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379
BULLMQ_ENABLED=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=120
BCRYPT_SALT_ROUNDS=10
UPLOAD_PATH=uploads/

# Cloudinary Configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret


# Email Configuration (if using email service)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM="Gogo <noreply@example.com>"


# Google Maps API Configuration
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Admin registration safeguard
ADMIN_REGISTRATION_CODE=secure-code-to-create-admins
ADMIN_NOTIFICATION_EMAILS=admin1@example.com,admin2@example.com


#Test Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=


# Password reset configuration
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# Socket.io Configuration
SOCKET_CORS_ORIGIN=https://gogo.org.in


# FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.


FIREBASE_SERVICE_ACCOUNT='{
  "type": "service_account",
  "project_id": "your-project-id",
  "private_key_id": "your_private_key_id",
  "private_key": "-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n",
  "client_email": "firebase-adminsdk-fbsvc@your-project-id.iam.gserviceaccount.com",
  "client_id": "your_client_id",
  "auth_uri": "https://accounts.google.com/o/oauth2/auth",
  "token_uri": "https://oauth2.googleapis.com/token",
  "auth_provider_x509_cert_url": "https://www.googleapis.com/oauth2/v1/certs",
  "client_x509_cert_url": "https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-fbsvc%40your-project-id.iam.gserviceaccount.com",
  "universe_domain": "googleapis.com"}'

VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app/



# ========================================
# SMS INDIA HUB CONFIGURATION
# ========================================
# Get these from your SMS India Hub account
# Set to 'true' to use default OTP (1234) for testing (development only)
# Set to 'false' in production!
USE_DEFAULT_OTP=true
STATIC_OTP_PHONE=8770552411
STATIC_OTP_CODE=1234

SMS_INDIA_HUB_USERNAME=your_sms_username
# SMS_INDIA_HUB_PASSWORD=your_sms_password
SMS_INDIA_HUB_API_KEY=your_sms_api_key
SMS_INDIA_HUB_SENDER_ID=IIDMTB
SMS_INDIA_HUB_DLT_TEMPLATE_ID=your_dlt_template_id
# ========================================
# OTP CONFIGURATION (PRODUCTION VALUES)
# ========================================
OTP_EXPIRY_MINUTES=10
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT=3
OTP_RATE_WINDOW=600
OTP_EXPIRY=5m

# Extra keys kept from existing env
DRIVER_WALLET_DEFAULT_CASH_LIMIT=500
DRIVER_COMMISSION_PERCENT=20
# CLOUDINARY_FOLDER=k9

# Petpooja POS Integration
PETPOOJA_ENABLED=true
PETPOOJA_API_KEY=test_key
PETPOOJA_CLIENT_CODE=test_client
PETPOOJA_OUTLET_ID=test_outlet
PETPOOJA_API_URL=https://api.petpooja.com/v2

DEPLOY_WEBHOOK_SECRET=your_webhook_secret

# Seed script credentials (scripts/seed-default-credentials.js)
# Required before running `npm run seed:default-credentials`.
SEED_ADMIN_EMAIL=admin@k9rides.local
SEED_ADMIN_PASSWORD=

# Driver unification: treat taxi drivers + delivery partners as one dispatch pool.
# Run `npm run migrate:unify-drivers --apply` BEFORE enabling this.
UNIFIED_DISPATCH_ENABLED=false

# ─── Service-Provider (Homster) module ─────────────────────────────────────
# Token lifetimes for SP's own mobile/web clients. Deliberately longer than the
# admin-web JWT_ACCESS_EXPIRES above: the shipped Flutter and seller-APK builds
# were released against these values, so shortening them forces constant refreshes.
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# SP dev OTP bypass (leave unset in production). Master's equivalents are
# USE_DEFAULT_OTP / STATIC_OTP_PHONE / STATIC_OTP_CODE; these two are consolidated
# away in phase 2 when SP moves onto core/otp.
ALLOW_TEST_OTP=
TEST_OTP_PHONE=

# SP SMS endpoint. Consolidated onto the shared SMS India Hub service in phase 2.
SMS_BASE_URL=

# SP reads REDIS_URL first and only falls back to these, so with REDIS_URL set
# above you can leave them empty.
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# SP's Firebase reads FIREBASE_CONFIG, then FIREBASE_SERVICE_ACCOUNT_JSON, then
# master's FIREBASE_SERVICE_ACCOUNT (above), then a file path. With
# FIREBASE_SERVICE_ACCOUNT set you can leave all of these empty.
FIREBASE_CONFIG=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# ─── Ecommerce module (modules/ecommerce) ──────────────────────────────────
# Everything below has a safe default in code and can be left unset.

# Branding on the share-link landing page (modules/ecommerce/landing/routes/shareLinks.routes.js).
ECOMMERCE_BRAND_NAME=Gogo
ECOMMERCE_APP_SCHEME=gogo
ECOMMERCE_SUPPORT_EMAIL=
ECOMMERCE_NOTIFICATION_IMAGE=

# Android App Links verification for shared seller/product links (same file).
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=
ANDROID_PLAY_STORE_URL=
IOS_APP_STORE_URL=

# Courier shipping provider for Shop (standard) orders. 'mock' (default) needs
# nothing below; 'shiprocket' needs the Shiprocket credentials.
SHIPPING_PROVIDER=mock
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=
SHIPROCKET_PICKUP_LOCATION=
SHIPROCKET_DEFAULT_PICKUP_PINCODE=

# Checkout / dispatch tuning (all optional; code defaults apply when unset).
ONLINE_PAYMENTS_ENABLED=true
COD_ENABLED=true
PACKING_MINUTES=
DISPATCH_RADIUS_BANDS_KM=
DISPATCH_STALE_GPS_MS=
AUTO_DELIVER_AFTER_HOURS=
FIRST_ORDER_PEPPER=
PUSH_CAMPAIGNS_INLINE=
STORE_TIMEZONE=Asia/Kolkata
DISPLAY_TIME_ZONE=
